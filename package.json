{
  "name": "cross-agent-sync",
  "version": "0.3.1",
  "description": "Cross-agent session sync: when you switch agents or start a new chat, one command brings over prior context, the original question (including images). Supports Claude Code / Codex / Cursor / OpenCode / Kiro / Trae and custom agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhbDesign/cross-agent-sync.git"
  },
  "homepage": "https://github.com/lhbDesign/cross-agent-sync#readme",
  "bugs": {
    "url": "https://github.com/lhbDesign/cross-agent-sync/issues"
  },
  "keywords": [
    "agent",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "kiro",
    "trae",
    "session",
    "handoff",
    "context",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "author": "lihaibo",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "bin": {
    "ass": "dist/cli.js",
    "cross-agent-sync": "dist/cli.js",
    "cross-agent-sync-mcp": "dist/mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node --test",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
